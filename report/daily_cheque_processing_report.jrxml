<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="daily_cheque_processing_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="20"
    bottomMargin="20">

    <queryString>
        <![CDATA[
            SELECT
                cheque_number,
                bank_name,
                branch_name,
                cheque_amount,
                processing_date,
                status
            FROM cheque_transaction
            WHERE processing_date = CURRENT_DATE
            ORDER BY cheque_number
        ]]>
    </queryString>

    <field name="cheque_number" class="java.lang.String"/>
    <field name="bank_name" class="java.lang.String"/>
    <field name="branch_name" class="java.lang.String"/>
    <field name="cheque_amount" class="java.math.BigDecimal"/>
    <field name="processing_date" class="java.sql.Timestamp"/>
    <field name="status" class="java.lang.String"/>


    <title>
        <band height="50">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="16"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[CTS - DAILY CHEQUE PROCESSING REPORT]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="0"
                    y="32"
                    width="782"
                    height="18"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"/>

                </textElement>

                <text><![CDATA[Daily Cheque Processing Details]]></text>
            </staticText>

        </band>
    </title>


    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="110"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Cheque No]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="110"
                    y="0"
                    width="160"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Bank]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="270"
                    y="0"
                    width="100"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Branch]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="370"
                    y="0"
                    width="115"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Amount]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="485"
                    y="0"
                    width="140"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Processing]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="625"
                    y="0"
                    width="157"
                    height="30"/>

                <box>
                    <pen lineWidth="1.0"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Status]]></text>
            </staticText>

        </band>
    </columnHeader>


    <detail>
        <band height="25">

            <textField>
                <reportElement
                    x="0"
                    y="0"
                    width="110"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{cheque_number}]]>
                </textFieldExpression>
            </textField>


            <textField>
                <reportElement
                    x="110"
                    y="0"
                    width="160"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{bank_name}]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement
                    x="270"
                    y="0"
                    width="100"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{branch_name}]]>
                </textFieldExpression>
            </textField>


            <textField pattern="#,##0.00">
                <reportElement
                    x="370"
                    y="0"
                    width="115"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{cheque_amount}]]>
                </textFieldExpression>
            </textField>


            <textField pattern="dd/MM/yyyy">
                <reportElement
                    x="485"
                    y="0"
                    width="140"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{processing_date}]]>
                </textFieldExpression>
            </textField>


            <textField>
                <reportElement
                    x="625"
                    y="0"
                    width="157"
                    height="25"/>

                <box>
                    <pen lineWidth="0.8"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{status}]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>


    <pageFooter>
        <band height="25">

            <staticText>
                <reportElement
                    x="0"
                    y="5"
                    width="300"
                    height="15"/>

                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <text><![CDATA[CTS - Cheque Processing System]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="680"
                    y="5"
                    width="40"
                    height="15"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <text><![CDATA[Page]]></text>
            </staticText>


            <textField>
                <reportElement
                    x="725"
                    y="5"
                    width="30"
                    height="15"/>

                <textElement
                    textAlignment="Left"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$V{PAGE_NUMBER}]]>
                </textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>