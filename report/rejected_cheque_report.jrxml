<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"

    name="rejected_cheque_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="30"
    bottomMargin="30">

    <!-- Parameter -->
    <parameter name="P_STATUS" class="java.lang.String"/>

    <!-- SQL Query -->
    <queryString>
        <![CDATA[
            SELECT cheque_number,
                   customer_name,
                   account_number,
                   cheque_amount,
                   rejection_reason
            FROM cheque_transaction
            WHERE status = $P{P_STATUS}
        ]]>
    </queryString>

    <!-- Fields -->

    <field name="cheque_number"
           class="java.lang.String"/>

    <field name="customer_name"
           class="java.lang.String"/>

    <field name="account_number"
           class="java.lang.String"/>

    <field name="cheque_amount"
           class="java.math.BigDecimal"/>

    <field name="rejection_reason"
           class="java.lang.String"/>

    <!-- Title -->

    <title>

        <band height="60">

            <staticText>

                <reportElement
                    x="0"
                    y="15"
                    width="782"
                    height="30"/>

                <textElement textAlignment="Center"/>

                <text><![CDATA[CTS - Rejected Cheque Report]]></text>

            </staticText>

        </band>

    </title>

    <!-- Column Header -->

    <columnHeader>

        <band height="30">

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="140"
                    height="30"/>

                <text><![CDATA[Cheque No]]></text>

            </staticText>

            <staticText>

                <reportElement
                    x="140"
                    y="0"
                    width="180"
                    height="30"/>

                <text><![CDATA[Customer]]></text>

            </staticText>

            <staticText>

                <reportElement
                    x="320"
                    y="0"
                    width="170"
                    height="30"/>

                <text><![CDATA[Account Number]]></text>

            </staticText>

            <staticText>

                <reportElement
                    x="490"
                    y="0"
                    width="120"
                    height="30"/>

                <text><![CDATA[Amount]]></text>

            </staticText>

            <staticText>

                <reportElement
                    x="610"
                    y="0"
                    width="172"
                    height="30"/>

                <text><![CDATA[Rejection Reason]]></text>

            </staticText>

        </band>

    </columnHeader>

    <!-- Detail -->

    <detail>

        <band height="30">

            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="140"
                    height="30"/>

                <textFieldExpression>
                    <![CDATA[$F{cheque_number}]]>
                </textFieldExpression>

            </textField>

            <textField>

                <reportElement
                    x="140"
                    y="0"
                    width="180"
                    height="30"/>

                <textFieldExpression>
                    <![CDATA[$F{customer_name}]]>
                </textFieldExpression>

            </textField>

            <textField>

                <reportElement
                    x="320"
                    y="0"
                    width="170"
                    height="30"/>

                <textFieldExpression>
                    <![CDATA[$F{account_number}]]>
                </textFieldExpression>

            </textField>

            <textField pattern="#,##0.00">

                <reportElement
                    x="490"
                    y="0"
                    width="120"
                    height="30"/>

                <textFieldExpression>
                    <![CDATA[$F{cheque_amount}]]>
                </textFieldExpression>

            </textField>

            <textField>

                <reportElement
                    x="610"
                    y="0"
                    width="172"
                    height="30"/>

                <textFieldExpression>
                    <![CDATA[$F{rejection_reason}]]>
                </textFieldExpression>

            </textField>

        </band>

    </detail>

</jasperReport>